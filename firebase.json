{
  "hosting": {
    "site": "transfarmation",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|wasm|css|png|jpg|svg|ico|woff2|otf|ttf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tinostaguta",
          "appId": "1:953657246968:android:2be5a22fbfda634417e70d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tinostaguta",
          "configurations": {
            "android": "1:953657246968:android:2be5a22fbfda634417e70d",
            "ios": "1:953657246968:ios:6d69490f47fd573817e70d",
            "macos": "1:953657246968:ios:6d69490f47fd573817e70d",
            "web": "1:953657246968:web:40573f29e4ff08db17e70d",
            "windows": "1:953657246968:web:13424943ebb76e3917e70d"
          }
        }
      }
    }
  }
}